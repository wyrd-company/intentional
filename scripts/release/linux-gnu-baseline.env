# ---
# relationships:
#   implements: intent-driven-polyglot-release
#   references: build-linux-gnu-release-on-pinned-cross-baseline
# ---

# Pinned cross-rs GNU toolchain inputs for Linux release builds.
CROSS_VERSION=0.2.5
RUST_VERSION=1.85.0

X86_64_GNU_CROSS_IMAGE=ghcr.io/cross-rs/x86_64-unknown-linux-gnu:0.2.5@sha256:9e5b39c09874bc1816c675ed11afca2c2ed6cee0c4ed2b3c1d5763c346c9ae3f
AARCH64_GNU_CROSS_IMAGE=ghcr.io/cross-rs/aarch64-unknown-linux-gnu:0.2.5@sha256:7f8308a8734d9fcd2ebbe9a3e4bdea74af293f0799d80c3cc341e340cda49a4c

# cross-rs source provenance for the pinned 0.2.5 GNU images.
CROSS_SOURCE_REPOSITORY=https://github.com/cross-rs/cross
CROSS_SOURCE_TAG=v0.2.5
CROSS_SOURCE_TAG_OBJECT=f8151ae777290430cf2108efacf3976d9528500b
CROSS_SOURCE_COMMIT=88f49ff79e777bef6d3564531636ee4d3cc2f8d2
CROSS_OCI_REVISION=88f49ff79e777bef6d3564531636ee4d3cc2f8d2
CROSS_OCI_VERSION=v0.2.5
CROSS_OCI_SOURCE=https://github.com/cross-rs/cross
CROSS_IMAGE_REGISTRY=ghcr.io/cross-rs

# Dockerfiles that produced the pinned GNU images at CROSS_SOURCE_COMMIT.
X86_64_GNU_DOCKERFILE=docker/Dockerfile.x86_64-unknown-linux-gnu
AARCH64_GNU_DOCKERFILE=docker/Dockerfile.aarch64-unknown-linux-gnu

# Build-container facts distinct from the release binary contract.
GNU_BUILD_BASE_DISTRO="Ubuntu 16.04"
GNU_BUILD_BASE_SUPPORT_STATUS=end-of-life
GNU_IMAGE_HOST_ARCH=amd64
GNU_SYSROOT_GLIBC_VERSION=2.23
GNU_BUILD_GIT_VERSION=2.7.4
GNU_BUILD_BASH_VERSION=4.3.48

# Host tools passed through and mounted at their absolute paths by Cross. The
# installer emits these values for both local and hosted workspace-test gates.
GNU_CROSS_PASSTHROUGH_ENVIRONMENT="ACTIONLINT JQ PYTHON_HOME SHELLCHECK RUSTC_WRAPPER GNU_BUILD_GIT_VERSION GNU_BUILD_BASH_VERSION"
GNU_CROSS_VOLUME_ENVIRONMENT="ACTIONLINT JQ PYTHON_HOME SHELLCHECK RUSTC_WRAPPER"
GNU_CROSS_TEST_ARGUMENTS="--workspace --locked --all-targets --no-fail-fast --target x86_64-unknown-linux-gnu"
GNU_CROSS_DOC_TEST_ARGUMENTS="--workspace --locked --doc --no-fail-fast --target x86_64-unknown-linux-gnu"

# Maximum GLIBC symbol version required by release-profile GNU binaries (ceiling).
# This is measured from the linked artifact, not the sysroot glibc version.
LINUX_GNU_MAX_GLIBC_SYMBOL=GLIBC_2.18

# Supported GNU runtime environments verified by the linux-gnu smoke workflow.
# Each environment provides glibc at least at the measured symbol ceiling.
UBUNTU_22_04_IMAGE=ubuntu:22.04@sha256:0e0a0fc6d18feda9db1590da249ac93e8d5abfea8f4c3c0c849ce512b5ef8982
UBUNTU_24_04_IMAGE=ubuntu:24.04@sha256:4fbb8e6a8395de5a7550b33509421a2bafbc0aab6c06ba2cef9ebffbc7092d90

# Baseline refresh triggers: Rust/compiler bump, image deletion or registry
# unavailability, measured GLIBC symbol-ceiling drift, or security/toolchain
# concerns. A replacement image must retain the same-or-older compatibility
# sysroot and pass the full linux-gnu evidence matrix; moving to the next cross
# tag alone is not sufficient without that proof.
