# ---
# relationships:
#   implements: intent-driven-polyglot-release
#   references: build-linux-gnu-release-on-pinned-cross-baseline
# ---

# Pinned cross-rs GNU toolchain inputs for Linux release builds.
CROSS_VERSION=0.2.5
RUST_VERSION=1.85.0

X86_64_GNU_CROSS_IMAGE=ghcr.io/cross-rs/x86_64-unknown-linux-gnu:0.2.5@sha256:9e5b39c09874bc1816c675ed11afca2c2ed6cee0c4ed2b3c1d5763c346c9ae3f
AARCH64_GNU_CROSS_IMAGE=ghcr.io/cross-rs/aarch64-unknown-linux-gnu:0.2.5@sha256:7f8308a8734d9fcd2ebbe9a3e4bdea74af293f0799d80c3cc341e340cda49a4c

# Maximum required GLIBC symbol version observed in release-profile GNU binaries.
LINUX_GNU_MAX_GLIBC_SYMBOL=GLIBC_2.18

# Supported GNU runtime environments verified by the linux-gnu smoke workflow.
UBUNTU_22_04_IMAGE=ubuntu:22.04@sha256:0e0a0fc6d18feda9db1590da249ac93e8d5abfea8f4c3c0c849ce512b5ef8982
UBUNTU_24_04_IMAGE=ubuntu:24.04@sha256:4fbb8e6a8395de5a7550b33509421a2bafbc0aab6c06ba2cef9ebffbc7092d90

# cross-rs image source provenance and lifecycle policy.
CROSS_SOURCE_REPOSITORY=https://github.com/cross-rs/cross
CROSS_SOURCE_TAG=v0.2.5
CROSS_IMAGE_REGISTRY=ghcr.io/cross-rs
